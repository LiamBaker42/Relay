<?php include 'views/template/header.phtml'; ?>

<div class="container">
    <!-- Staff Search Section -->
    <div class="staff-search-section">
        <h2>Search Staff</h2>
        <form method="get" class="staff-search-form">
            <!-- Preserve the event ID in the URL -->
            <input type="hidden" name="id" value="<?= htmlspecialchars($eventId) ?>">
            <input
                    type="text"
                    name="search"
                    placeholder="Search staff"
                    value="<?= isset($_GET['search']) ? htmlspecialchars($_GET['search']) : '' ?>"
                    class="search-input"
            >
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>

    <!-- Staff List Section -->
    <div class="staff-list-section">
        <h2>Staff Available for Event</h2>
        <ul class="staff-list">
            <?php if (!empty($viewData['staffList'])): ?>
                <?php foreach ($viewData['staffList'] as $staff): ?>
                    <li class="staff-item">
                        <span><?= htmlspecialchars($staff['Name']) ?></span>
                        <form method="post" class="add-staff-form">
                            <input type="hidden" name="staffId" value="<?= $staff['StaffID'] ?>">
                            <button type="submit" name="addStaff" class="btn btn-success">Add to Event</button>
                        </form>
                    </li>
                <?php endforeach; ?>
            <?php else: ?>
                <p class="no-staff-message">No staff found.</p>
            <?php endif; ?>
        </ul>
    </div>
</div>
<div class="pagination">
    <?php if ($page > 1): ?>
        <a href="?id=<?= htmlspecialchars($eventId) ?>&page=1">First</a>
        <a href="?id=<?= htmlspecialchars($eventId) ?>&page=<?= $page - 1 ?>">Previous</a>
    <?php endif; ?>

    <?php for ($i = 1; $i <= $totalPages; $i++): ?>
        <a href="?id=<?= htmlspecialchars($eventId) ?>&page=<?= $i ?>" class="<?= $i == $page ? 'active' : '' ?>"><?= $i ?></a>
    <?php endfor; ?>

    <?php if ($page < $totalPages): ?>
        <a href="?id=<?= htmlspecialchars($eventId) ?>&page=<?= $page + 1 ?>">Next</a>
        <a href="?id=<?= htmlspecialchars($eventId) ?>&page=<?= $totalPages ?>">Last</a>
    <?php endif; ?>

    <!-- Page Input -->
    <form action="" method="get" class="page-input-form" style="display: inline;">
        <label for="page-input">Go to page:</label>
        <input type="number" id="page-input" name="page" min="1" max="<?= $totalPages ?>" value="<?= $page ?>" required>
        <input type="hidden" name="id" value="<?= htmlspecialchars($eventId) ?>">
        <button type="submit">Go</button>
    </form>
</div>


<?php include 'views/template/footer.phtml'; ?>
