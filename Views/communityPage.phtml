
<script>
    function changeMonth(direction) {
        // Get current month and year from the hidden fields
        let month = parseInt(document.getElementById('month').value);
        let year = parseInt(document.getElementById('year').value);

        // Adjust the month based on direction (previous or next)
        if (direction === 'prev') {
            month = (month === 1) ? 12 : month - 1;
            if (month === 12) year -= 1; // If going from January to December, adjust the year
        } else if (direction === 'next') {
            month = (month === 12) ? 1 : month + 1;
            if (month === 1) year += 1; // If going from December to January, adjust the year
        }

        // Update the hidden fields with the new values
        document.getElementById('month').value = month;
        document.getElementById('year').value = year;

        // Make an AJAX request to fetch the events for the new month
        const xhr = new XMLHttpRequest();
        xhr.open('GET', 'communityPage.php?month=' + month + '&year=' + year, true);
        xhr.onreadystatechange = function () {
            if (xhr.readyState == 4 && xhr.status == 200) {
                // Update the content with the new events
                document.getElementById('events-container').innerHTML = xhr.responseText;
            }
        };
        xhr.send();
    }
</script>
