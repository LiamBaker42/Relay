<?php include 'template/header.phtml'; ?>

<div class="staff-details-container">
    <h1>Staff Details</h1>

    <!-- Button to add a new contact -->
    <div class="add-contact-btn-container">
        <a href="/contactEdit.php?staffId=<?= $staffDetails['StaffID'] ?>" class="add-contact-btn">Add Contact</a>
    </div>
    <!-- Staffs info -->
    <div class="staff-info">
        <p><strong>Name:</strong> <?= htmlspecialchars($staffDetails['Name']) ?></p>
        <p><strong>Email:</strong> <?= htmlspecialchars($staffDetails['Email']) ?></p>
        <p><strong>Phone:</strong> <?= htmlspecialchars($staffDetails['Phone']) ?></p>
        <p><strong>Type:</strong> <?= htmlspecialchars($staffDetails['Type']) ?></p>
        <p><strong>Total Contacts:</strong> <?= count($contacts) ?></p>
    </div>
    <!-- Contacts list -->
    <h2>Contacts</h2>
    <?php if (count($contacts) > 0): ?>
        <ul class="contacts-list">
            <?php foreach ($contacts as $contact): ?>
                <li class="contact-item">
                    <!-- Contact link to view details -->
                    <a href="/ContactDetails.php?id=<?= htmlspecialchars($contact['ContactID']) ?>" class="contact-link">
                        <?= htmlspecialchars($contact['Name']) ?>
                    </a>
                    <span class="conversation-count">(Conversations: <?= htmlspecialchars($contact['conversationCount']) ?>)</span>

                    <!-- Last contacted display -->
                    <span class="last-contacted">
                        <?php if (!empty($contact['lastContacted'])): ?>
                            <?php
                            // Format the date to a more user-friendly format
                            $formattedDate = date('H:i, d M', strtotime($contact['lastContacted']));
                            ?>
                            Last Contacted: <?= htmlspecialchars($formattedDate) ?>
                        <?php else: ?>
                            No conversations yet
                        <?php endif; ?>
                    </span>

                    <!-- Form to handle edit contact securely -->
                    <form action="/contactEdit.php" method="POST" style="display:inline;">
                        <input type="hidden" name="contactId" value="<?= htmlspecialchars($contact['ContactID']) ?>">
                        <input type="hidden" name="staffId" value="<?= htmlspecialchars($staffDetails['StaffID']) ?>">
                        <button type="submit" name="edit_contact" class="edit-contact-btn">Edit</button>
                    </form>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php else: ?>
        <p>No contacts found for this staff member.</p>
    <?php endif; ?>
</div>

<div class="pagination">
    <?php if ($page > 1): ?>
        <a href="?id=<?= $staffDetails['StaffID'] ?>&page=1">First</a>
        <a href="?id=<?= $staffDetails['StaffID'] ?>&page=<?= $page - 1 ?>">Previous</a>
    <?php endif; ?>

    <?php for ($i = 1; $i <= $totalPages; $i++): ?>
        <a href="?id=<?= $staffDetails['StaffID'] ?>&page=<?= $i ?>" class="<?= $i == $page ? 'active' : '' ?>"><?= $i ?></a>
    <?php endfor; ?>

    <?php if ($page < $totalPages): ?>
        <a href="?id=<?= $staffDetails['StaffID'] ?>&page=<?= $page + 1 ?>">Next</a>
        <a href="?id=<?= $staffDetails['StaffID'] ?>&page=<?= $totalPages ?>">Last</a>
    <?php endif; ?>

    <!-- Page Input -->
    <form action="" method="get" class="page-input-form">
        <label for="page-input">Go to page:</label>
        <input type="number" id="page-input" name="page" min="1" max="<?= $totalPages ?>" value="<?= $page ?>" required>
        <input type="hidden" name="id" value="<?= $staffDetails['StaffID'] ?>">
        <button type="submit">Go</button>
    </form>
</div>




