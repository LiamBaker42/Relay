<?php include 'template/header.phtml'; ?>

<div class="contact-details-container">
    <h1>Contact Details</h1>

    <!-- Add Conversation Button -->
    <div class="text-right mb-3">
        <form action="/conversationEdit.php" method="get">
            <input type="hidden" name="contactId" value="<?= htmlspecialchars($contactDetails['ContactID']) ?>">
            <button type="submit" class="btn btn-primary">Add Conversation</button>
        </form>
    </div>

    <div class="contact-info">
        <p><strong>Name:</strong> <?= htmlspecialchars($contactDetails['Name']) ?></p>
        <p><strong>Email:</strong> <?= htmlspecialchars($contactDetails['Email']) ?></p>
        <p><strong>Phone:</strong> <?= htmlspecialchars($contactDetails['Number']) ?></p>

        <!-- Last Contacted Date -->
        <p><strong>Last Contacted:</strong>
            <?= $lastContacted ? htmlspecialchars(date('F j, Y, g:i a', strtotime($lastContacted))) : 'No conversations yet' ?>
        </p>
    </div>

    <h2>Conversations</h2>
    <?php if (count($conversations) > 0): ?>
        <ul class="conversation-list">
            <?php foreach ($conversations as $conversation): ?>
                <div class="conversation-item" style="position: relative;">
                    <!-- Existing Conversation Details -->
                    <strong>Type:</strong> <?= htmlspecialchars($conversation['ConversationType']) ?><br>
                    <strong>Summary:</strong> <?= htmlspecialchars($conversation['Summary']) ?><br>
                    <strong>Conversation Date:</strong> <?= htmlspecialchars(date('F j, Y, g:i a', strtotime($conversation['ConversationDate']))) ?>

                    <!-- Edit Button -->
                    <div style="position: absolute; right: 0; top: 0;">
                        <form action="/conversationEdit.php" method="get" style="display:inline;">
                            <input type="hidden" name="contactId" value="<?= htmlspecialchars($contactDetails['ContactID']) ?>">
                            <input type="hidden" name="conversationId" value="<?= htmlspecialchars($conversation['ConversationID']) ?>">
                            <button type="submit" class="edit-contact-btn">Edit</button>
                        </form>
                    </div>
                </div>
            <?php endforeach; ?>
        </ul>
    <?php else: ?>
        <p>No conversations found for this contact.</p>
    <?php endif; ?>
</div>


<div class="pagination">
    <?php if ($page > 1): ?>
        <a href="?id=<?= $contactDetails['ContactID'] ?>&page=1">First</a>
        <a href="?id=<?= $contactDetails['ContactID'] ?>&page=<?= $page - 1 ?>">Previous</a>
    <?php endif; ?>

    <?php for ($i = 1; $i <= $totalPages; $i++): ?>
        <a href="?id=<?= $contactDetails['ContactID'] ?>&page=<?= $i ?>" class="<?= $i == $page ? 'active' : '' ?>"><?= $i ?></a>
    <?php endfor; ?>

    <?php if ($page < $totalPages): ?>
        <a href="?id=<?= $contactDetails['ContactID'] ?>&page=<?= $page + 1 ?>">Next</a>
        <a href="?id=<?= $contactDetails['ContactID'] ?>&page=<?= $totalPages ?>">Last</a>
    <?php endif; ?>

    <!-- Page Input -->
    <form action="" method="get" class="page-input-form">
        <label for="page-input">Go to page:</label>
        <input type="number" id="page-input" name="page" min="1" max="<?= $totalPages ?>" value="<?= $page ?>" required>
        <button type="submit">Go</button>
    </form>
</div>



